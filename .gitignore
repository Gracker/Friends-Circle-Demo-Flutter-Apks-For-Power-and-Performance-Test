# Flutter/Dart specific
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/doc/api/
**/.metadata
**/.DS_Store
**/*.iml
**/.idea/
**/.vscode/

# Android specific
**/.gradle
**/local.properties
**/GeneratedPluginRegistrant.*
**/.cxx/
**/app/.cxx/

# iOS specific
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace/

# Project specific - ignore build outputs in subprojects
3.19_SurfaceView/build/
3.19_TextureView/build/
3.27_SurfaceView/build/
3.27_TextureView/build/
3.29_SurfaceView/build/
3.29_TextureView/build/

# Project specific - ignore apk folders in subprojects
3.19_SurfaceView/apk/
3.19_TextureView/apk/
3.27_SurfaceView/apk/
3.27_TextureView/apk/
3.29_SurfaceView/apk/
3.29_TextureView/apk/

**/.fvm/
**/.fvmrc

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# Keep root level files and folders
!/apk-release/
!/*.sh
!/*.md
!/.github/

# Android signing (keep template, ignore actual files)
android/signing/keystore.properties
android/signing/*.keystore
android/signing/*.jks
!android/signing/*.template
